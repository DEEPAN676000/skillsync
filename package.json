{
  "name": "skillsync-monorepo",
  "version": "1.0.0",
  "description": "SkillSync - Complete Full-Stack Skill Sharing Marketplace Platform",
  "private": true,
  "scripts": {
    "dev": "node start-dev.mjs",
    "dev:client": "npm.cmd --prefix client run dev",
    "dev:server": "npm.cmd --prefix server run start",
    "build:server": "npm.cmd --prefix server run build",
    "build:client": "npm.cmd --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm.cmd --prefix server run start",
    "test": "node server/test-inmemory.mjs"
  },
  "keywords": [
    "skillsync",
    "skill-sharing",
    "marketplace",
    "react",
    "nodejs",
    "typescript",
    "mongodb",
    "razorpay",
    "jitsi"
  ],
  "author": "SkillSync Engineering",
  "license": "MIT"
}
